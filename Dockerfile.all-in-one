FROM node:20-slim AS frontend-build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

FROM python:3.12-slim
RUN apt-get update && apt-get install -y \
    supervisor redis-server curl gnupg nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# MinIO
RUN curl -o /usr/local/bin/minio https://dl.min.io/server/minio/release/linux-amd64/minio \
    && chmod +x /usr/local/bin/minio

# Backend
WORKDIR /app/backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .

# Frontend (built assets)
COPY --from=frontend-build /frontend /app/frontend

# Config
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV DATABASE_URL=sqlite+aiosqlite:////data/cachette.db
ENV MINIO_DATA=/data/minio
VOLUME /data

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]